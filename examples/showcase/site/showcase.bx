<VStack spacing={0} align="stretch">
  <HStack padding_x={10} padding_y={6} spacing={10} align="center" background={self.chrome} wrap>
    <Label text="Cortado" font_size={15} text_color={self.ink} />
    <Label text="macOS tokens, small control size" font_size={self.footnote} text_color={self.muted} />
    <Box grow={1} />
    <Label text="Appearance" font_size={self.footnote} text_color={self.muted} />
    <Segmented key={"appearance"} selected={self.mode} items={self.modes} width={120}
               on:change={fn(e: UiEvent) { self.set_mode(e.index) }} />
    <Label text="Size" font_size={self.footnote} text_color={self.muted} />
    <Segmented key={"size"} selected={self.control_size} items={self.control_sizes} width={200}
               on:change={fn(e: UiEvent) { self.set_control_size(e.index) }} />
    <Label text="Accent" font_size={self.footnote} text_color={self.muted} />
    $for index in 0..self.accent_names.len() {
      <Button key={"accent-{index}"} text={self.accent_names[index]}
              on:click={fn(e: UiEvent) { self.set_accent(index) }} />
    }
    <Button key={"window-key"} text={if self.window_active { "Window: key" } else { "Window: inactive" }}
            on:click={fn(e: UiEvent) { self.toggle_active() }} />
  </HStack>
  <Separator height={1} />

  <ScrollView grow={1}>
    <VStack padding={10} spacing={10} align="stretch">
      <HStack spacing={10} align="start">

        <VStack grow={1} spacing={4} align="stretch">
          <Label text="ACTIONS" font_size={self.caption} text_color={self.muted} />
          <HStack spacing={5} align="center" wrap>
            <Button key={"order"} text="Order" on:click={fn(e: UiEvent) { self.order() }} />
            <Button key={"undo"} text="Undo" on:click={fn(e: UiEvent) { self.undo() }} />
            <Button key={"clear"} text="Clear" on:click={fn(e: UiEvent) { self.clear() }} />
            <Label text={"{self.orders} placed"} font_size={self.footnote} text_color={self.muted} />
          </HStack>

          <Box height={4} />
          <Label text="STATES" font_size={self.caption} text_color={self.muted} />
          <HStack spacing={5} align="center" wrap>
            <Button key={"state-normal"} text="Normal" />
            <Button key={"state-prominent"} text="Prominent" prominent />
            <Button key={"state-off"} text="Disabled" enabled={false} />
            <Button key={"state-prominent-off"} text="Prominent off" prominent enabled={false} />
          </HStack>
          <HStack spacing={12} align="center" wrap>
            <CheckBox key={"state-check-on"} text="Checked" checked />
            <CheckBox key={"state-check-off"} text="Unchecked" />
            <CheckBox key={"state-check-dis"} text="Disabled" checked enabled={false} />
            <Switch key={"state-switch-on"} checked />
            <Switch key={"state-switch-off"} />
          </HStack>
          <Label text="Click a control to see its pressed and focused states."
                 font_size={self.caption} text_color={self.muted} />

          <Box height={4} />
          <Label text="TYPOGRAPHY" font_size={self.caption} text_color={self.muted} />
          <Label text="Large title" font_size={self.large_title} text_color={self.ink} />
          <Label text="Title 1" font_size={self.title1} text_color={self.ink} />
          <Label text="Headline" font_size={self.headline_size} font_weight={5} text_color={self.ink} />
          <Label text="Body — the control font at this size" font_size={self.font_size} text_color={self.ink} />
          <Label text="Footnote" font_size={self.footnote} text_color={self.muted} />

          <Box height={4} />
          <Label text="TOGGLES" font_size={self.caption} text_color={self.muted} />
          <CheckBox key={"milk"} text="Include milk" checked={self.milk}
                    on:change={fn(e: UiEvent) { self.set_milk(e.index) }} />
          <HStack spacing={12} align="center" wrap>
            <RadioButton key={"small"} text="Small" checked={self.size == 0}
                         on:change={fn(e: UiEvent) { self.set_size(0, e.index) }} />
            <RadioButton key={"medium"} text="Medium" checked={self.size == 1}
                         on:change={fn(e: UiEvent) { self.set_size(1, e.index) }} />
            <RadioButton key={"large"} text="Large" checked={self.size == 2}
                         on:change={fn(e: UiEvent) { self.set_size(2, e.index) }} />
          </HStack>
          <HStack spacing={6} align="center">
            <Label text="Notify when ready" text_color={self.ink} font_size={self.font_size} grow={1} />
            <Switch key={"notify"} checked={self.notify}
                    on:change={fn(e: UiEvent) { self.set_notify(e.index) }} />
          </HStack>

          <Box height={4} />
          <Label text="VALUES" font_size={self.caption} text_color={self.muted} />
          <HStack spacing={6} align="center">
            <Label text={"Strength {self.strength}"} text_color={self.ink} font_size={self.font_size} width={90} />
            <Slider key={"strength"} min={0.0} max={100.0} value={self.strength} step={5.0} grow={1}
                    on:change={fn(e: UiEvent) { self.set_strength(e.index) }} />
          </HStack>
          <HStack spacing={6} align="center">
            <Label text={"Shots {self.shots}"} text_color={self.ink} font_size={self.font_size} width={90} />
            <Stepper key={"shots"} min={0.0} max={6.0} value={self.shots} step={1.0}
                     on:change={fn(e: UiEvent) { self.set_shots(e.index) }} />
            <Box grow={1} />
          </HStack>
          <HStack spacing={6} align="center">
            <Label text="Brewing" text_color={self.muted} font_size={self.footnote} width={90} />
            <ProgressBar key={"brewing"} min={0.0} max={100.0} value={self.strength} grow={1} />
          </HStack>
          <HStack spacing={6} align="center">
            <Label text="Bean level" text_color={self.muted} font_size={self.footnote} width={90} />
            <LevelIndicator key={"beans"} min={0.0} max={100.0} value={self.strength} grow={1} />
          </HStack>
        </VStack>

        <VStack grow={1} spacing={4} align="stretch">
          <Label text="TEXT" font_size={self.caption} text_color={self.muted} />
          <HStack spacing={6} align="center">
            <Label text="Name" text_color={self.muted} font_size={self.footnote} width={60} />
            <TextField key={"name"} bind:value={self.name} grow={1} />
          </HStack>
          <HStack spacing={6} align="center">
            <Label text="Search" text_color={self.muted} font_size={self.footnote} width={60} />
            <SearchField key={"search"} bind:value={self.query} grow={1} />
          </HStack>
          <HStack spacing={6} align="center">
            <Label text="Secret" text_color={self.muted} font_size={self.footnote} width={60} />
            <SecureField key={"secret"} bind:value={self.secret} grow={1} />
          </HStack>
          <TextArea key={"note"} bind:value={self.note} width_percent={100.0} height={44} />

          <Box height={4} />
          <Label text="CHOICES" font_size={self.caption} text_color={self.muted} />
          <HStack spacing={6} align="center">
            <Label text="Drink" text_color={self.muted} font_size={self.footnote} width={60} />
            <ComboBox key={"drink"} selected={self.drink} items={self.drinks} grow={1}
                      on:change={fn(e: UiEvent) { self.set_drink(e.index) }} />
          </HStack>
          <Segmented key={"roast"} selected={self.roast} items={self.roasts}
                     on:change={fn(e: UiEvent) { self.set_roast(e.index) }} />
          <TabView key={"tabs"} selected={self.tab} labels={self.tabs} height={86}
                   on:change={fn(e: UiEvent) { self.set_tab(e.index) }}>
            <VStack key={"recipe"} padding={6} spacing={2} align="stretch">
              <Label text={"{self.roasts[self.roast]} · {self.drinks[self.drink]}"}
                     text_color={self.ink} font_size={self.font_size} />
              <Label text={"{self.shots} shots, strength {self.strength}"}
                     font_size={self.footnote} text_color={self.muted} />
              <Label text={"Milk {self.milk} · {self.sizes[self.size]} · notify {self.notify}"}
                     font_size={self.footnote} text_color={self.muted} />
            </VStack>
            <VStack key={"notes"} padding={6} align="stretch">
              <Label text={if self.note == "" { "No notes yet." } else { self.note }}
                     text_color={self.ink} font_size={self.font_size} />
            </VStack>
          </TabView>

          <Box height={4} />
          <Label text="CONTAINERS" font_size={self.caption} text_color={self.muted} />
          <Disclosure key={"details"} text="Order details" open={self.details} height={56}
                      on:change={fn(e: UiEvent) { self.set_details(e.index) }}>
            <Button key={"roasted"} text="Roasted today" on:click={fn(e: UiEvent) { self.order() }} />
          </Disclosure>
          <SplitView key={"split"} stacked={false} divider={self.divider} height={62}
                     on:change={fn(e: UiEvent) { self.set_divider(e.index) }}>
            <VStack key={"left"} padding={6} align="stretch" background={self.card}>
              <Label text="Drag me" text_color={self.ink} font_size={self.font_size} />
            </VStack>
            <VStack key={"right"} padding={6} align="stretch" background={self.card}>
              <Label text={"{self.divider} across"} text_color={self.muted} font_size={self.footnote} />
            </VStack>
          </SplitView>
        </VStack>
      </HStack>

      <Label text="TABLE — 500 rows, only the visible ones are read"
             font_size={self.caption} text_color={self.muted} />
      <Table key={"orders"} columns={self.columns} column_widths={self.widths}
             source={self.rows} height={200}
             on:select={fn(e: UiEvent) { self.select_row(e.index) }} />
      <Label text={if self.row < 0 { "No row selected" } else { "Row {self.row} selected" }}
             font_size={self.footnote} text_color={self.muted} />
    </VStack>
  </ScrollView>
</VStack>
<beans>
package site

import cortado.component
import cortado.render
import cortado.widgets
import {view} from cortado.annotations

pub class OrderRows implements widgets.TableRows {
    pub fn init() {}
    pub fn row_count() -> int { return 500 }
    pub fn cell(row: int, column: int) -> string {
        if column == 0 { return "#{1000 + row}" }
        if column == 1 { return if row % 3 == 0 { "Espresso" } else if row % 3 == 1 { "Latte" } else { "Cortado" } }
        return "{2 + row % 4} min"
    }
}

/// The whole demo. Appearance and accent are pushed into the window's own
/// theme, so every control below repaints from the same tokens.
@view
pub partial class Showcase extends component.Component {
    pub theme: Option<render.Theme> = none
    pub ink: string = "#000000d8"
    pub muted: string = "#0000007f"
    pub card: string = "#ffffffff"
    pub chrome: string = "#f4f4f4ff"
    pub font_size: f64 = 11.0
    pub footnote: f64 = 10.0
    pub caption: f64 = 9.0

    pub modes: List<string> = ["Light", "Dark"]
    pub mode: int = 0
    pub control_sizes: List<string> = ["Mini", "Small", "Regular", "Large"]
    pub control_size: int = 2
    pub window_active: bool = true
    pub large_title: f64 = 26.0
    pub title1: f64 = 22.0
    pub headline_size: f64 = 13.0
    pub accent_names: List<string> = ["Blue", "Pink", "Green", "Orange", "Purple"]
    pub accent_values: List<int> = [0x0088ffff, 0xff2d55ff, 0x34c759ff, 0xff8d28ff, 0xcb30e0ff]

    pub orders: int = 0
    pub milk: bool = false
    pub size: int = 0
    pub sizes: List<string> = ["Small", "Medium", "Large"]
    pub notify: bool = true
    pub strength: f64 = 45.0
    pub shots: f64 = 2.0
    pub name: string = "Julfikar"
    pub query: string = ""
    pub secret: string = ""
    pub note: string = ""
    pub drinks: List<string> = ["Espresso", "Latte", "Cortado", "Flat white"]
    pub drink: int = 2
    pub roasts: List<string> = ["Light", "Medium", "Dark"]
    pub roast: int = 1
    pub tabs: List<string> = ["Recipe", "Notes"]
    pub tab: int = 0
    pub details: bool = false
    pub divider: f64 = 260.0
    pub columns: List<string> = ["Order", "Drink", "Wait"]
    pub widths: List<f64> = [140.0, 200.0, 120.0]
    pub rows: OrderRows
    pub row: int = -1

    pub fn init() { self.rows = new OrderRows(); super.init() }

    pub fn use_theme(theme: render.Theme) {
        self.theme = some(theme)
        self.resync()
    }
    /// The three colours this view paints itself with. Controls read the
    /// theme directly; a plain component has to copy what it needs.
    fn resync() {
        match self.theme {
            some(theme) => {
                self.ink = render.Theme.hex(theme.foreground())
                self.muted = render.Theme.hex(theme.secondary_label())
                self.card = render.Theme.hex(theme.card())
                self.chrome = render.Theme.hex(theme.sunken())
                self.font_size = theme.font_size()
                self.footnote = theme.footnote()
                self.caption = theme.caption1()
                self.large_title = theme.large_title()
                self.title1 = theme.title1()
                self.headline_size = theme.headline()
            }
            none => {}
        }
        self.request_render()
    }
    pub fn set_mode(index: int) {
        if index < 0 || index >= self.modes.len() { return }
        self.mode = index
        match self.theme { some(theme) => { theme.set_dark(index == 1) } none => {} }
        self.resync()
    }
    /// macOS control sizes. They move height, radius, padding and font at once,
    /// which is why one picker drives them all.
    pub fn set_control_size(index: int) {
        if index < 0 || index >= self.control_sizes.len() { return }
        self.control_size = index
        match self.theme {
            some(theme) => { match theme.set_control_size(index) { ok(done) => {} err(problem) => {} } }
            none => {}
        }
        self.resync()
    }
    /// Shows what every filled control does when its window loses the keyboard.
    pub fn toggle_active() {
        self.window_active = !self.window_active
        match self.theme { some(theme) => { theme.set_window_active(self.window_active) } none => {} }
        self.resync()
    }
    pub fn set_accent(index: int) {
        if index < 0 || index >= self.accent_values.len() { return }
        match self.theme { some(theme) => { theme.set_accent(self.accent_values[index]) } none => {} }
        self.resync()
    }

    pub fn order() { self.orders += 1; self.request_render() }
    pub fn undo() { if self.orders > 0 { self.orders -= 1; self.request_render() } }
    pub fn clear() { self.orders = 0; self.request_render() }
    pub fn set_milk(value: int) { self.milk = value == 1; self.request_render() }
    pub fn set_size(which: int, value: int) { if value == 1 { self.size = which; self.request_render() } }
    pub fn set_notify(value: int) { self.notify = value == 1; self.request_render() }
    pub fn set_strength(value: int) { self.strength = value as f64; self.request_render() }
    pub fn set_shots(value: int) { self.shots = value as f64; self.request_render() }
    pub fn set_drink(index: int) { self.drink = index; self.request_render() }
    pub fn set_roast(index: int) { self.roast = index; self.request_render() }
    pub fn set_tab(index: int) { self.tab = index; self.request_render() }
    pub fn set_details(value: int) { self.details = value == 1; self.request_render() }
    pub fn set_divider(value: int) { self.divider = value as f64; self.request_render() }
    pub fn select_row(index: int) { self.row = index; self.request_render() }
}
</beans>
