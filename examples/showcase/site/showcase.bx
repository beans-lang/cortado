<VStack spacing={0} align="stretch">
  <VStack padding={20} spacing={12} align="stretch" background={self.card}>
    <Label text="Cortado" font_size={34} text_color={self.ink} />
    <Label text="Every control here is drawn by Skia with the iOS 26 design tokens."
           font_size={15} text_color={self.muted} />
    <HStack spacing={12} align="center" wrap>
      <Label text="Appearance" font_size={13} text_color={self.muted} />
      <Segmented key={"appearance"} selected={self.mode} items={self.modes} width={180}
                 on:change={fn(e: UiEvent) { self.set_mode(e.index) }} />
      <Box width={16} />
      <Label text="Accent" font_size={13} text_color={self.muted} />
      $for index in 0..self.accent_names.len() {
        <Button key={"accent-{index}"} text={self.accent_names[index]}
                on:click={fn(e: UiEvent) { self.set_accent(index) }} />
      }
    </HStack>
  </VStack>
  <Separator height={1} />

  <ScrollView grow={1}>
    <VStack padding={20} spacing={18} align="stretch">

      <Label text="BUTTONS" font_size={13} text_color={self.muted} />
      <VStack padding={14} spacing={12} align="stretch" background={self.card} corner_radius={10}>
        <HStack spacing={10} align="center" wrap>
          <Button key={"order"} text="Order a coffee" on:click={fn(e: UiEvent) { self.order() }} />
          <Button key={"undo"} text="Undo" on:click={fn(e: UiEvent) { self.undo() }} />
          <Button key={"clear"} text="Clear" on:click={fn(e: UiEvent) { self.clear() }} />
        </HStack>
        <Label text={"{self.orders} ordered · tab through them, then press space"}
               font_size={13} text_color={self.muted} />
      </VStack>

      <Label text="TOGGLES" font_size={13} text_color={self.muted} />
      <VStack padding={14} spacing={12} align="stretch" background={self.card} corner_radius={10}>
        <CheckBox key={"milk"} text="Include milk" checked={self.milk}
                  on:change={fn(e: UiEvent) { self.set_milk(e.index) }} />
        <HStack spacing={18} align="center">
          <RadioButton key={"small"} text="Small" checked={self.size == 0}
                       on:change={fn(e: UiEvent) { self.set_size(0, e.index) }} />
          <RadioButton key={"medium"} text="Medium" checked={self.size == 1}
                       on:change={fn(e: UiEvent) { self.set_size(1, e.index) }} />
          <RadioButton key={"large"} text="Large" checked={self.size == 2}
                       on:change={fn(e: UiEvent) { self.set_size(2, e.index) }} />
        </HStack>
        <HStack spacing={12} align="center">
          <Label text="Notify me when it is ready" text_color={self.ink} grow={1} />
          <Switch key={"notify"} checked={self.notify}
                  on:change={fn(e: UiEvent) { self.set_notify(e.index) }} />
        </HStack>
      </VStack>

      <Label text="VALUES" font_size={13} text_color={self.muted} />
      <VStack padding={14} spacing={12} align="stretch" background={self.card} corner_radius={10}>
        <Label text={"Strength {self.strength}"} text_color={self.ink} />
        <Slider key={"strength"} min={0.0} max={100.0} value={self.strength} step={5.0}
                on:change={fn(e: UiEvent) { self.set_strength(e.index) }} />
        <HStack spacing={12} align="center">
          <Label text={"Shots {self.shots}"} text_color={self.ink} grow={1} />
          <Stepper key={"shots"} min={0.0} max={6.0} value={self.shots} step={1.0}
                   on:change={fn(e: UiEvent) { self.set_shots(e.index) }} />
        </HStack>
        <Label text={"Brewing {self.strength}%"} font_size={13} text_color={self.muted} />
        <ProgressBar key={"brewing"} min={0.0} max={100.0} value={self.strength} />
        <Label text="Bean level" font_size={13} text_color={self.muted} />
        <LevelIndicator key={"beans"} min={0.0} max={100.0} value={self.strength} />
      </VStack>

      <Label text="TEXT" font_size={13} text_color={self.muted} />
      <VStack padding={14} spacing={12} align="stretch" background={self.card} corner_radius={10}>
        <TextField key={"name"} bind:value={self.name} width_percent={100.0} />
        <SearchField key={"search"} bind:value={self.query} width_percent={100.0} />
        <SecureField key={"secret"} bind:value={self.secret} width_percent={100.0} />
        <TextArea key={"note"} bind:value={self.note} width_percent={100.0} height={70} />
        <Label text={"Hello {self.name} — searching \"{self.query}\""}
               font_size={13} text_color={self.muted} />
      </VStack>

      <Label text="CHOICES" font_size={13} text_color={self.muted} />
      <VStack padding={14} spacing={12} align="stretch" background={self.card} corner_radius={10}>
        <ComboBox key={"drink"} selected={self.drink} items={self.drinks} width={220}
                  on:change={fn(e: UiEvent) { self.set_drink(e.index) }} />
        <Segmented key={"roast"} selected={self.roast} items={self.roasts}
                   on:change={fn(e: UiEvent) { self.set_roast(e.index) }} />
        <TabView key={"tabs"} selected={self.tab} labels={self.tabs} height={120}
                 on:change={fn(e: UiEvent) { self.set_tab(e.index) }}>
          <VStack key={"recipe"} padding={12} align="stretch">
            <Label text={"{self.roasts[self.roast]} · {self.drinks[self.drink]}"} text_color={self.ink} />
            <Label text={"{self.shots} shots, strength {self.strength}"}
                   font_size={13} text_color={self.muted} />
          </VStack>
          <VStack key={"notes"} padding={12} align="stretch">
            <Label text={if self.note == "" { "No notes yet." } else { self.note }} text_color={self.ink} />
          </VStack>
        </TabView>
      </VStack>

      <Label text="CONTAINERS" font_size={13} text_color={self.muted} />
      <GroupBox text="Order options" height={90}>
        <Label text={"Milk {self.milk}, size {self.sizes[self.size]}, notify {self.notify}"}
               text_color={self.ink} />
      </GroupBox>
      <Disclosure key={"details"} text="Order details" open={self.details} height={96}
                  on:change={fn(e: UiEvent) { self.set_details(e.index) }}>
        <Button key={"roasted"} text="Roasted today" on:click={fn(e: UiEvent) { self.order() }} />
      </Disclosure>
      <SplitView key={"split"} stacked={false} divider={self.divider} height={120}
                 on:change={fn(e: UiEvent) { self.set_divider(e.index) }}>
        <VStack key={"left"} padding={12} align="stretch" background={self.card}>
          <Label text="Drag the divider" text_color={self.ink} />
        </VStack>
        <VStack key={"right"} padding={12} align="stretch" background={self.card}>
          <Label text={"{self.divider} across"} text_color={self.muted} />
        </VStack>
      </SplitView>

      <Label text="TABLE" font_size={13} text_color={self.muted} />
      <Table key={"orders"} columns={self.columns} column_widths={self.widths}
             source={self.rows} height={180}
             on:select={fn(e: UiEvent) { self.select_row(e.index) }} />
      <Label text={if self.row < 0 { "No row selected" } else { "Row {self.row} selected" }}
             font_size={13} text_color={self.muted} />
    </VStack>
  </ScrollView>
</VStack>
<beans>
package site

import cortado.component
import cortado.render
import cortado.widgets
import {view} from cortado.annotations

pub class OrderRows implements widgets.TableRows {
    pub fn init() {}
    pub fn row_count() -> int { return 500 }
    pub fn cell(row: int, column: int) -> string {
        if column == 0 { return "#{1000 + row}" }
        if column == 1 { return if row % 3 == 0 { "Espresso" } else if row % 3 == 1 { "Latte" } else { "Cortado" } }
        return "{2 + row % 4} min"
    }
}

/// The whole demo. Appearance and accent are pushed into the window's own
/// theme, so every control below repaints from the same tokens.
@view
pub partial class Showcase extends component.Component {
    pub theme: Option<render.Theme> = none
    pub ink: string = "#000000ff"
    pub muted: string = "#3c3c4399"
    pub card: string = "#ffffffff"

    pub modes: List<string> = ["Light", "Dark"]
    pub mode: int = 0
    pub accent_names: List<string> = ["Blue", "Pink", "Green", "Orange", "Purple"]
    pub accent_values: List<int> = [0x0088ffff, 0xff2d55ff, 0x34c759ff, 0xff8d28ff, 0xcb30e0ff]

    pub orders: int = 0
    pub milk: bool = false
    pub size: int = 0
    pub sizes: List<string> = ["Small", "Medium", "Large"]
    pub notify: bool = true
    pub strength: f64 = 45.0
    pub shots: f64 = 2.0
    pub name: string = "Julfikar"
    pub query: string = ""
    pub secret: string = ""
    pub note: string = ""
    pub drinks: List<string> = ["Espresso", "Latte", "Cortado", "Flat white"]
    pub drink: int = 2
    pub roasts: List<string> = ["Light", "Medium", "Dark"]
    pub roast: int = 1
    pub tabs: List<string> = ["Recipe", "Notes"]
    pub tab: int = 0
    pub details: bool = false
    pub divider: f64 = 260.0
    pub columns: List<string> = ["Order", "Drink", "Wait"]
    pub widths: List<f64> = [140.0, 200.0, 120.0]
    pub rows: OrderRows
    pub row: int = -1

    pub fn init() { self.rows = new OrderRows(); super.init() }

    pub fn use_theme(theme: render.Theme) {
        self.theme = some(theme)
        self.resync()
    }
    /// The three colours this view paints itself with. Controls read the
    /// theme directly; a plain component has to copy what it needs.
    fn resync() {
        match self.theme {
            some(theme) => {
                self.ink = render.Theme.hex(theme.foreground())
                self.muted = render.Theme.hex(theme.secondary_label())
                self.card = render.Theme.hex(theme.card())
            }
            none => {}
        }
        self.request_render()
    }
    pub fn set_mode(index: int) {
        if index < 0 || index >= self.modes.len() { return }
        self.mode = index
        match self.theme { some(theme) => { theme.set_dark(index == 1) } none => {} }
        self.resync()
    }
    pub fn set_accent(index: int) {
        if index < 0 || index >= self.accent_values.len() { return }
        match self.theme { some(theme) => { theme.set_accent(self.accent_values[index]) } none => {} }
        self.resync()
    }

    pub fn order() { self.orders += 1; self.request_render() }
    pub fn undo() { if self.orders > 0 { self.orders -= 1; self.request_render() } }
    pub fn clear() { self.orders = 0; self.request_render() }
    pub fn set_milk(value: int) { self.milk = value == 1; self.request_render() }
    pub fn set_size(which: int, value: int) { if value == 1 { self.size = which; self.request_render() } }
    pub fn set_notify(value: int) { self.notify = value == 1; self.request_render() }
    pub fn set_strength(value: int) { self.strength = value as f64; self.request_render() }
    pub fn set_shots(value: int) { self.shots = value as f64; self.request_render() }
    pub fn set_drink(index: int) { self.drink = index; self.request_render() }
    pub fn set_roast(index: int) { self.roast = index; self.request_render() }
    pub fn set_tab(index: int) { self.tab = index; self.request_render() }
    pub fn set_details(value: int) { self.details = value == 1; self.request_render() }
    pub fn set_divider(value: int) { self.divider = value as f64; self.request_render() }
    pub fn select_row(index: int) { self.row = index; self.request_render() }
}
</beans>
