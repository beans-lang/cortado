module cortado
kind library

# The macOS host. Every Objective-C detail in cortado stops inside `src/mac/`;
# the .m suffix is what tells clang to compile it as Objective-C, the same way
# raylib's Cocoa backend does it.
#
# One file per concern rather than one file per platform. The host was a single
# 1,600-line translation unit, and the work coming — Core Animation, Metal, and
# the device frameworks — would have made it unreadable. What the files share
# is `src/mac/internal.h`, which is private to this platform: no other host and
# no Beans file ever sees it, and `tools/check_abi.sh` fails the build if an
# AppKit name reaches Beans.
csrc macos "src/mac/handles.m"
csrc macos "src/mac/app.m"
csrc macos "src/mac/surface.m"
csrc macos "src/mac/widget.m"
csrc macos "src/mac/view.m"
csrc macos "src/mac/property.m"
csrc macos "src/mac/dialog.m"
csrc macos "src/mac/system.m"
csrc macos "src/mac/menu.m"
csrc macos "src/mac/items.m"
csrc macos "src/mac/introspect.m"

link macos framework "AppKit"
link macos framework "Foundation"

# The iOS host. Same header, same Beans above it — `tests/roles.out` is the
# same bytes on both, which is the claim this file exists to make testable.
# What differs is what the platform does not have: there is no menu bar on a
# phone, so `ctd_capability(CTD_CAP_MENU_BAR)` answers no and every menu call
# is a typed refusal rather than a silent no-op.
csrc ios "src/ios/handles.m"
csrc ios "src/ios/app.m"
csrc ios "src/ios/surface.m"
csrc ios "src/ios/widget.m"
csrc ios "src/ios/view.m"
csrc ios "src/ios/property.m"
csrc ios "src/ios/menu.m"
csrc ios "src/ios/items.m"
csrc ios "src/ios/dialog.m"
csrc ios "src/ios/system.m"
csrc ios "src/ios/introspect.m"

link ios framework "UIKit"
link ios framework "Foundation"
# CGRectZero and CGRectIsEmpty come from CoreGraphics, and UIKit does not pull
# it in transitively when frameworks are named explicitly.
link ios framework "CoreGraphics"

# The Linux host, over GTK4. The same header again, and a third object system:
# GObject rather than Objective-C, signals rather than target/action, floating
# references rather than retain/release. `tests/roles.out` is the same bytes
# through it — `tools/gtk4.sh` builds and runs it here, using GTK4's macOS
# backend, because a third implementation that nobody could compile would prove
# nothing.
#
# The include paths GTK4 needs are twenty directories that differ on every
# machine, so they are not written here — they are generated, on the machine
# that builds:
#
#     beansc pot update --system gtk4 linux
#
# That writes a `cflags linux` row and the `link linux` rows between markers
# this file does not yet carry, and re-running it updates them in place. A
# manifest that listed them by hand would name one computer.
csrc linux "src/gtk4/handles.c"
csrc linux "src/gtk4/app.c"
csrc linux "src/gtk4/surface.c"
csrc linux "src/gtk4/widget.c"
csrc linux "src/gtk4/view.c"
csrc linux "src/gtk4/property.c"
csrc linux "src/gtk4/menu.c"
csrc linux "src/gtk4/items.c"
csrc linux "src/gtk4/dialog.c"
csrc linux "src/gtk4/system.c"
csrc linux "src/gtk4/introspect.c"

# The Windows host, over Win32 and common controls v6. A fourth object system,
# or rather the absence of one: a control is an HWND, its state is set by
# sending it a message, and it reports what happened by sending a message back
# to its *parent*. `tests/roles.out` is the same bytes through it.
#
# `tools/win32.sh` builds and runs it from a Mac, using mingw-w64 for the C
# half and llc for the Beans half, because beansc's bundled clang has no
# Windows sysroot to compile against. On a Windows machine this manifest is
# all that is needed and the rows below are what beansc links.
csrc windows "src/win32/handles.c"
csrc windows "src/win32/app.c"
csrc windows "src/win32/surface.c"
csrc windows "src/win32/widget.c"
csrc windows "src/win32/view.c"
csrc windows "src/win32/property.c"
csrc windows "src/win32/menu.c"
csrc windows "src/win32/items.c"
csrc windows "src/win32/dialog.c"
csrc windows "src/win32/system.c"
csrc windows "src/win32/introspect.c"

# Common controls carries the trackbar and the progress bar; comdlg32 the file
# choosers; gdi32 the device contexts every measurement goes through. user32
# and kernel32 the toolchain links on its own.
link windows library "comctl32"
link windows library "comdlg32"
link windows library "gdi32"
link windows library "user32"
link windows library "advapi32"
