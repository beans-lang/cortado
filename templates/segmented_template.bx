<HStack background={self.track_off} corner_radius={self.radius_medium} padding={2} align="stretch" spacing={2}>
  $for index in 0..self.choices.len() {
    <Label key={"segment-{index}"} text={self.choices[index]}
           text_color={self.ink}
           background={if self.selected == index { self.card } else { "#00000000" }}
           corner_radius={self.radius_small} font_size={self.font_size} grow={1} alignment={1} />
  }
</HStack>
<beans>
package templates
import cortado.component
import {view} from cortado.annotations
@view
pub partial class SegmentedTemplate extends component.ChoiceControlTemplate {
    pub fn init() { super.init() }
}
</beans>
