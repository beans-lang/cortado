<HStack spacing={self.toggle_gap} align="start">
  <Box width={self.toggle_size} height={self.toggle_size}
       background={if self.checked { self.accent_fill } else { self.track_off }}
       corner_radius={self.capsule}>
    $if self.checked {
      <Ellipse x={self.toggle_size * 0.34375} y={self.toggle_size * 0.34375}
               width={self.toggle_size * 0.3125} height={self.toggle_size * 0.3125}
               fill={self.on_accent} />
    }
  </Box>
  <Label text={self.title} text_color={self.ink} font_size={self.font_size}
         baseline={self.toggle_baseline} grow={1} height={self.toggle_size} />
</HStack>
<beans>
package templates
import cortado.component
import {view} from cortado.annotations
@view
pub partial class RadioButtonTemplate extends component.ToggleControlTemplate {
    pub fn init() { super.init() }
}
</beans>
