<HStack spacing={8} align="center">
  <HStack background="#00000000" border_color={self.track} border_width={2}
          corner_radius={self.capsule} width={20} height={20} align="center" justify="center">
    $if self.checked { <Box width={10} height={10} background={self.accent} corner_radius={self.capsule} /> }
  </HStack>
  <Label text={self.title} text_color={self.ink} font_size={self.font_size} />
</HStack>
<beans>
package templates
import cortado.component
import {view} from cortado.annotations
@view
pub partial class RadioButtonTemplate extends component.ToggleControlTemplate {
    pub fn init() { super.init() }
}
</beans>
