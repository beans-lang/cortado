<HStack spacing={5} align="center">
  <HStack background={if self.checked { self.accent } else { self.background }}
          border_color={if self.checked { self.accent } else { self.track }} border_width={1}
          corner_radius={self.capsule} width={14} height={14} align="center" justify="center">
    $if self.checked { <Box width={5} height={5} background={self.knob} corner_radius={self.capsule} /> }
  </HStack>
  <Label text={self.title} text_color={self.ink} font_size={self.font_size} />
</HStack>
<beans>
package templates
import cortado.component
import {view} from cortado.annotations
@view
pub partial class RadioButtonTemplate extends component.ToggleControlTemplate {
    pub fn init() { super.init() }
}
</beans>
