<Box background={self.surface} corner_radius={self.radius}
     width_percent={100.0} height_percent={100.0}>
  <Path x={(self.stepper_width - self.stepper_glyph_width) / 2.0} y={self.stepper_glyph_top}
        width={self.stepper_glyph_width} height={self.stepper_glyph_height * 0.34}
        d={"M0 {self.stepper_glyph_height * 0.34} L{self.stepper_glyph_width / 2.0} 0 L{self.stepper_glyph_width} {self.stepper_glyph_height * 0.34}"}
        stroke={self.ink} stroke_width={self.stepper_stroke}
        stroke_cap="round" stroke_join="round" fill="#00000000" />
  <Box x={(self.stepper_width - self.stepper_glyph_width) / 2.0}
       y={self.stepper_glyph_top + self.stepper_glyph_height / 2.0}
       width={self.stepper_glyph_width} height={self.hairline_width}
       background={self.separator} />
  <Path x={(self.stepper_width - self.stepper_glyph_width) / 2.0}
        y={self.stepper_glyph_top + self.stepper_glyph_height * 0.66}
        width={self.stepper_glyph_width} height={self.stepper_glyph_height * 0.34}
        d={"M0 0 L{self.stepper_glyph_width / 2.0} {self.stepper_glyph_height * 0.34} L{self.stepper_glyph_width} 0"}
        stroke={self.ink} stroke_width={self.stepper_stroke}
        stroke_cap="round" stroke_join="round" fill="#00000000" />
</Box>
