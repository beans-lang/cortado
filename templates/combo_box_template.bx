<HStack background={self.fill} corner_radius={self.radius}
        border_width={1} border_color={if self.focused { self.accent } else { self.separator }}
        padding_x={6} padding_y={2} align="center" spacing={4}>
  <Label text={self.selected_text} text_color={self.ink} font_size={self.font_size} grow={1} />
  <Label text="⌄" text_color={self.muted} font_size={self.font_size} />
</HStack>
