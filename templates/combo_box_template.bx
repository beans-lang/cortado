<HStack background={self.fill} border_color={if self.focused { self.accent } else { "#00000000" }}
        border_width={if self.focused { 2.0 } else { 0.0 }} corner_radius={self.radius_medium}
        padding={6} align="center" spacing={8}>
  <Label text={self.selected_text} text_color={self.ink} font_size={self.font_size} grow={1} />
  <Label text="⌄" text_color={self.accent} font_size={self.font_size} />
</HStack>
