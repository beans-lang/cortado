<HStack background={self.track} corner_radius={self.capsule} padding={2} align="center">
  $if self.checked { <Box grow={1} /> }
  <Box width={24} height={24} background={self.knob} corner_radius={self.capsule} />
  $if !self.checked { <Box grow={1} /> }
</HStack>
<beans>
package templates
import cortado.component
import {view} from cortado.annotations
@view
pub partial class SwitchTemplate extends component.ToggleControlTemplate {
    pub fn init() { super.init() }
}
</beans>
