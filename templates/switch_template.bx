<HStack background={self.track} corner_radius={14} padding={3} align="center">
  $if self.checked { <Box grow={1} /> }
  <Box width={22} height={22} background="#ffffffff" corner_radius={11} />
  $if !self.checked { <Box grow={1} /> }
</HStack>
