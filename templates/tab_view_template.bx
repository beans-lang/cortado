<VStack background={self.card} border_color={self.separator} border_width={1}
        corner_radius={self.radius} align="stretch">
  $if !self.borderless {
    <HStack height={20} background={self.track_off} align="stretch" spacing={1} padding={1}>
      $for index in 0..self.labels.len() {
        <Label key={"tab-{index}"} text={self.labels[index]}
               text_color={self.ink}
               background={if self.selected == index { self.card } else { "#00000000" }}
               corner_radius={self.radius_small} font_size={self.font_size} grow={1} alignment={1} />
      }
    </HStack>
  }
</VStack>
<beans>
package templates
import cortado.component
import {view} from cortado.annotations
@view
pub partial class TabViewTemplate extends component.TabControlTemplate {
    pub fn init() { super.init() }
}
</beans>
