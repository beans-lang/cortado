<VStack background={self.card} border_color={self.separator} border_width={self.hairline_width}
        corner_radius={self.radius} align="stretch">
  $if !self.borderless {
    <!-- The tab row is a segmented control centred above the box, which is
         what NSTabView draws: same bezel, same pill, same padding. -->
    <HStack height={self.control_height + self.spacing} align="center" justify="center">
      <HStack background={self.surface} corner_radius={self.radius}
              height={self.control_height} align="stretch" shrink={0}>
        $for index in 0..self.labels.len() {
          <Box key={"tab-{index}"} padding_x={self.segment_padding / 2.0}
               background={if self.selected == index { self.selection_fill } else { self.clear }}
               corner_radius={self.radius}>
            <Label text={self.labels[index]}
                   text_color={if self.selected == index && self.active { self.on_accent } else { self.ink }}
                   font_weight={if self.selected == index { self.selected_weight } else { 0 }}
                   background={self.clear}
                   font_size={self.font_size} baseline={self.baseline}
                   alignment={1} width_percent={100.0} height_percent={100.0} />
          </Box>
        }
      </HStack>
    </HStack>
  }
</VStack>
<beans>
package templates
import cortado.component
import {view} from cortado.annotations
@view
pub partial class TabViewTemplate extends component.TabControlTemplate {
    pub fn init() { super.init() }
}
</beans>
