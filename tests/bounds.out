-- one bound, and the frame it moves --
  max_width=60: w -1..60, h -1..-1
== a label that measures 100 wide, capped at 60, stretched in 300 ==
VStack stack frame=0,0,300,100
  Label leaf frame=0,0,60,20
  min_width=140: w 140..-1, h -1..-1
  max_height=12: w -1..-1, h -1..12
== a label that measures 20 tall, capped at 12 ==
VStack stack frame=0,0,300,100
  Label leaf frame=0,0,300,12
  min_height=40: w -1..-1, h 40..-1
== and one raised to 40 ==
VStack stack frame=0,0,300,100
  Label leaf frame=0,0,300,40
-- source order decides, bound by bound --
  width=150 then max_width=200: w 150..200, h -1..-1
== which stretches to the cap, not the pin ==
VStack stack frame=0,0,300,100
  Label leaf frame=0,0,200,20
  max_width=200 then width=150: w 150..150, h -1..-1
== which is pinned ==
VStack stack frame=0,0,300,100
  Label leaf frame=0,0,150,20
-- a range that ends up reversed --
  min_width=200 max_width=100 is refused: true
  and the message says why: true
  max_height=10 min_height=20 is refused: true
  and the message says why: true
  width=150 then min_width=200 is refused: true
  and the message says why: true
  but equal bounds are a pin, and fine: w 100..100, h -1..-1
-- on a component tag --
  max_width=200 places the root: w -1..200, h -1..-1
-- a share of the room, and a shape --
  width_percent=50 is kept as a share: w 50%, h -1%
== half the width of a stretched 300 ==
VStack stack frame=0,0,300,100
  Label leaf frame=0,0,150,20
== half the width, three times as wide as tall ==
VStack stack frame=0,0,300,100
  Label leaf frame=0,0,150,50
== a tenth, but at least 80 ==
VStack stack frame=0,0,300,100
  Label leaf frame=0,0,80,20
  width_percent=150 is refused: true
  and the message says why: true
  height_percent=-5 is refused: true
  and the message says why: true
  width=100 then width_percent=50 is refused: true
  and the message says why: true
  width_percent=50 then width=100 is refused: true
  and the message says why: true
  aspect_ratio=0 is refused: true
  and the message says why: true
  aspect_ratio=1.5 on a component tag: 1.5
-- a bound inside a flexing row --
== two growing labels in 300, the first capped at 120 ==
HFlex flex frame=0,0,300,40
  Label leaf frame=0,0,120,20
  Label leaf frame=120,0,180,20
