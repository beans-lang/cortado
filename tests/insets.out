-- source order decides, edge by edge --
  padding=8 then padding_x=16: 8,16,8,16
  padding_x=16 then padding=8: 8,8,8,8
  and the two are not the same box: true
  padding_y=5 then padding_top=12: 12,0,5,0
== padding=8 padding_x=16 ==
VStack stack frame=0,0,300,100
  Label leaf frame=16,8,268,20
-- every container that takes padding takes an edge of it --
  <HStack> keeps: 2,0,0,11
  <VFlex> keeps: 2,0,0,11
  <HFlex> keeps: 2,0,0,11
  <Grid> keeps: 2,0,0,11
  <Box> keeps: 2,0,0,11
-- margins --
  hangs left: 0,7,0,5
  sits low: 3,0,3,0
  one side wider: 6,6,6,20
