-- columns written out --
== 160 points, a share, and the widest child ==
Grid grid frame=0,0,600,200
  Label leaf frame=0,0,100,20
  Label leaf frame=170,0,100,20
  Label leaf frame=500,0,100,20
== two shares, unequal ==
Grid grid frame=0,0,600,200
  Label leaf frame=0,0,100,20
  Label leaf frame=200,0,100,20
-- the same name twice is the last one, not both --
== two shares, then three, is three ==
Grid grid frame=0,0,600,200
  Label leaf frame=0,0,100,20
  Label leaf frame=200,0,100,20
  Label leaf frame=400,0,100,20
-- a ceiling is on the share, not on a number somebody wrote --
== a fixed column keeps its width under a ceiling of 100 ==
Grid grid frame=0,0,600,200
  Label leaf frame=0,0,100,20
  Label leaf frame=310,0,100,20
== and auto keeps the widest child in it ==
Grid grid frame=0,0,600,200
  Label leaf frame=0,0,100,20
  Label leaf frame=110,0,40,20
-- a grid told nothing is the one column it always was --
== two tiles, one column ==
Grid grid frame=0,0,400,200
  Label leaf frame=0,0,100,20
  Label leaf frame=0,20,100,20
-- what is refused --
  columns and min_column together is refused: true
  and the message says why: true
  min_column and columns, written the other way round is refused: true
  and the message says why: true
  a column that is not a column is refused: true
  and the message says why: true
  a list with no columns in it is refused: true
  and the message says why: true
  a ceiling under the floor is refused: true
  and the message says why: true
  a floor over the ceiling, the other way round is refused: true
  and the message says why: true
  columns on a run is refused: true
  and the message says why: true
  a column gap on a run is refused: true
  and the message says why: true
