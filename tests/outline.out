-- what this platform has --
  an outline is a control here exactly where the kind says so: true
-- the round trip --
  the platform answers what the source says: true
  and a node it is not showing is refused: true
-- opening --
  the root is open and cannot be closed: true
  a node starts shut: true
  and opens: true
  its children are now the control's: true
  a node inside a shut parent is not: true
  and closes again: true
-- what it cost --
  opening one node of 400,004 cost under a thousand questions: true
  and it really is that big: true
-- selection --
  a selected node reads back: true
  and none of that was reported as the user's doing: true
  the root means nothing is selected: true
  a node it is not showing is refused: true
-- a second column --
  a second column is given, or refused as unsupported: true
drove=true
